# ---------------------------------------------------------------------------
# Helios — Configuración de entorno
#
# Este archivo documenta TODAS las variables que usa docker-compose.yml.
# Los valores de abajo son credenciales LOCALES DE DESARROLLO: existen sólo
# dentro de la red de Docker en la máquina de quien levanta el proyecto y no dan
# acceso a ningún entorno real. Ningún secreto de producción se versiona.
#
# Uso:
#   1. `docker compose up --build` ya funciona sin hacer nada (hay defaults).
#   2. Para generar credenciales locales propias:  scripts/bootstrap.sh
#      (o scripts/bootstrap.ps1 en PowerShell). Crea .env, que está en .gitignore.
#   3. En la nube, estas variables se inyectan por el panel de variables de
#      entorno del proveedor, nunca por archivo.
# ---------------------------------------------------------------------------

# --- General ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
KONG_LOG_LEVEL=notice

# --- Puertos publicados en el host ----------------------------------------
PUERTO_GATEWAY=8000
PUERTO_MOCK=4010

# --- Firma de JWT ----------------------------------------------------------
# Secreto HS256 compartido entre el gateway (valida) y el emisor de tokens (firma).
# En producción: rotar y almacenar en el gestor de secretos del proveedor.
HELIOS_JWT_SECRET=dev-only-no-usar-en-la-nube

# --- PostgreSQL (catalog-service y stock-service, bases separadas) --------
PG_USUARIO=helios
PG_CLAVE=helios_dev

# --- MongoDB (import-service) ---------------------------------------------
MONGO_USUARIO=helios
MONGO_CLAVE=helios_dev

# --- RabbitMQ --------------------------------------------------------------
RABBITMQ_USUARIO=helios
RABBITMQ_CLAVE=helios_dev

# --- Elasticsearch ---------------------------------------------------------
# Subir a -Xms1g -Xmx1g si se indexa el catálogo completo.
ES_JAVA_OPTS=-Xms512m -Xmx512m

# --- Reglas de negocio configurables --------------------------------------
# Minutos que una reserva mantiene el stock bloqueado sin confirmar.
MINUTOS_VIGENCIA_RESERVA=15
# TTL de la caché de resultados de búsqueda, en segundos.
TTL_CACHE_BUSQUEDA_SEG=60

# --- Proveedor externo (capacidad consumida de otro grupo) ----------------
# URL base del proveedor de pagos asignado por la cátedra. Hasta la Entrega 2
# apunta al mock local para poder ejercitar el camino de integración.
PROVEEDOR_PAGOS_URL=http://mock-contrato:4010
TIMEOUT_PROVEEDOR_MS=2000
