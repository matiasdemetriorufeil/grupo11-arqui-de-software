# ---------------------------------------------------------------------------
# Normalización de fin de línea.
#
# Importa de verdad en este proyecto: los scripts de `scripts/` se ejecutan en
# bash y los archivos de `db/init/` y `api-gateway/` se montan dentro de
# contenedores Linux. Si alguien clona en Windows con `core.autocrlf=true`, un
# .sh con CRLF falla con "\r: command not found" y la promesa de "clonar y
# levantar con un comando" se rompe en la máquina de otro integrante.
#
# Con esto, el fin de línea no depende de la configuración local de cada uno.
# ---------------------------------------------------------------------------

# Por defecto: Git detecta texto y lo normaliza a LF, en el repo y al clonar.
* text=auto eol=lf

# Explícito donde el fin de línea cambia el comportamiento.
*.sh         text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.sql        text eol=lf
*.js         text eol=lf
*.json       text eol=lf
Dockerfile   text eol=lf

# PowerShell es la excepción: se ejecuta en Windows.
*.ps1        text eol=crlf

# Binarios: Git no los toca.
*.png        binary
*.jpg        binary
*.pdf        binary
*.xlsx       binary
*.zip        binary
